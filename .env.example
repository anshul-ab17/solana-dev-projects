# RPC URL for the Solana network
# For local testing use: http://localhost:8899
# For devnet use: https://api.devnet.solana.com
RPC_URL=http://localhost:8899

# Transaction confirmation level
# Options: 'processed', 'confirmed', 'finalized'
COMMITMENT=confirmed

# Default amount of SOL to airdrop (can be overridden per run)
AIRDROP_AMOUNT=1

# Default public key to receive airdrop (replace with actual user wallet)
DEFAULT_PUBLIC_KEY=EnterYourPublicKeyHere
